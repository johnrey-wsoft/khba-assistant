NODE_ENV=development

# ─── Required ────────────────────────────────────────────────────────
# Supabase: use cloud credentials OR local Supabase (npx supabase start).
# Local Supabase defaults:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key from supabase start output>

DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Site URL (used for SEO metadata, defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Optional: AI (OpenAI) ──────────────────────────────────────────
# Required for the /chat assistant (/api/chat). Read automatically by
# the @ai-sdk/openai provider. Get one from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Optional: Document ingestion (LlamaCloud) ──────────────────────
# Required only to run `pnpm ingest` (agentic OCR of real documents).
# Read automatically by the @llamaindex/llama-cloud client.
# Get one from https://cloud.llamaindex.ai (API Keys).
LLAMA_CLOUD_API_KEY=

# ─── Optional: HWP / HWPX parsing (Local Java hwp-api) ─────────────────
# Required only to ingest .hwp / .hwpx files. Self-hosted Java service
# (hwplib + hwpxlib) — see ./java-hwp. No API key required.
# Set NEXT_PUBLIC_API_URL to the service URL (e.g., http://localhost:8000).


# ─── Optional: Object storage (Cloudflare R2) ──────────────────────
# Stores the raw source documents (.hwp/.pdf/…) that the ingestion pipeline
# uploads, referenced from document_version. When unset, ingestion keeps the
# local file path and the /api/documents/[code]/download route returns 404.
# Create an R2 bucket + API token at https://dash.cloudflare.com (R2).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional — defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ─── Optional: Email (Resend) ───────────────────────────────────────
# Leave empty to disable email sending. The /api/mail/send endpoint
# will return "Email service not configured" when these are not set.
RESEND_API_KEY=
RESEND_EMAIL_FROM=

# ─── Optional: Rate Limiting (Upstash Redis) ────────────────────────
# Leave empty to disable rate limiting. All API routes will work
# normally without it — requests just won't be rate-limited.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Optional: FastAPI Backend URL ───────────────────────────────────
# URL of your Python FastAPI backend (e.g., Railway deployment)
# Leave empty to use local development server
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Optional: MarkItDown parser (Local FastAPI + markitdown) ──────────
# Free, self-hosted alternative to LlamaParse for non-HWP formats
# (PDF, DOCX, PPTX, XLSX, images, ...). Runs the python-markitdown service.
# Not wired into the pipeline yet — set this when you switch parse.ts over.
MARKITDOWN_API_URL=http://localhost:8001
