# MarkItDown FastAPI Environment Variables
# Railway will set PORT automatically
PORT=8001

# Optional: enables image (.png/.jpg) transcription/description via OpenAI
# vision. Without it, images return only EXIF metadata (little/no text).
OPENAI_API_KEY=
# Vision model used for images (default: gpt-4o)
MARKITDOWN_LLM_MODEL=gpt-4o
